# Copy to .env.local for local overrides. Never commit real values.

# PostgreSQL connection string. Leave unset locally to use the built-in PGlite database in .data/.
# Production: the Cloud SQL connection string, supplied by Secret Manager.
DATABASE_URL=

# 32 random bytes, base64 encoded. Encrypts two-step secrets. Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Public base URL used in emailed links. Required in production.
APP_URL=http://localhost:3000

# Minutes of inactivity before a web session ends (spec: 15).
SESSION_IDLE_MINUTES=15

# Bearer token Cloud Scheduler sends to /api/cron. Required in production (Secret Manager).
CRON_SECRET=

# Email for invitations and resets. Leave unset locally: emails are printed to the dev server log.
# Production: smtps://user:password@smtp.provider.com:465 (Secret Manager), and the sender name.
SMTP_URL=
MAIL_FROM=CareHouse One <no-reply@localhost>

# Breached-password check (Have I Been Pwned range API). Set to "off" only if outbound internet is blocked.
PWNED_CHECK=on

# Set to "false" to skip applying migrations when a production server starts.
RUN_MIGRATIONS=true

# Public site (www). Locally the site is http://www.localhost:3000 and these can stay unset.
SITE_URL=
CONTACT_EMAIL=hello@carehouseone.com
# Where "Request a demo" submissions are emailed.
LEADS_EMAIL=

# Self-service sign-up with PayPal. Keep SIGNUP_OPEN off until the Terms and BAA are final.
SIGNUP_OPEN=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
